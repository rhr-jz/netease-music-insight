MUSIC_INSIGHT_ENV=production
MUSIC_INSIGHT_HOST=0.0.0.0
MUSIC_INSIGHT_PORT=8000
# Generate a random secret of at least 32 characters before deployment.
MUSIC_INSIGHT_SECRET=
# An HTTPS origin only, without a path or trailing slash.
MUSIC_INSIGHT_PUBLIC_URL=https://music.example.com
MUSIC_INSIGHT_SESSION_TTL=3600
MUSIC_INSIGHT_RESULT_TTL=3600
MUSIC_INSIGHT_MAX_ACTIVE_JOBS=5
MUSIC_INSIGHT_MAX_SESSIONS=100
